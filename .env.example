# Copier ce fichier en .env (jamais versionné) : cp .env.example .env

# --- Agent ---
# Dans Docker Compose, l'agent joint l'API par son nom de service.
# Hors conteneur, utiliser http://127.0.0.1:8000/metrics
METRICS_ENDPOINT=http://api:8000/metrics
# Intervalle entre deux collectes, en secondes
COLLECTION_INTERVAL=5
# Timeout HTTP en secondes
REQUEST_TIMEOUT=5

# --- API ---
# Nombre maximum de métriques gardées en mémoire
MAX_STORED_METRICS=1000

# --- Monitoring (docker-compose.monitoring.yml) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
