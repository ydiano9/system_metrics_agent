# syntax=docker/dockerfile:1

# Tag précis (version Python + distribution) : builds reproductibles,
# jamais "latest". Variante slim : glibc (wheels manylinux compatibles),
# ~10x plus légère que l'image complète.

# ---------- Étape 1 : builder ----------
FROM python:3.12.15-slim-trixie AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# Environnement virtuel isolé, copié tel quel dans l'image finale
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Dépendances copiées AVANT le code : cette couche reste en cache
# tant que requirements-api.txt ne change pas.
WORKDIR /build
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# ---------- Étape 2 : image finale ----------
FROM python:3.12.15-slim-trixie AS runtime

LABEL org.opencontainers.image.title="system-metrics-api" \
      org.opencontainers.image.source="https://github.com/Mficius/system_metrics_agent"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# Utilisateur système sans privilèges, sans shell de connexion
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --no-create-home \
    --shell /usr/sbin/nologin app

WORKDIR /srv
COPY --from=builder /opt/venv /opt/venv
# Seul le code applicatif est copié (pas de tests, pas de .env)
COPY --chown=app:app app/ ./app/
RUN rm -rf ./app/tests

USER app

EXPOSE 8000

# Pas de curl dans l'image slim : on réutilise Python pour le check
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).status == 200 else 1)"]

# Forme exec : uvicorn est le PID 1 et reçoit SIGTERM. Pas de --reload.
CMD ["uvicorn", "app.api:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
